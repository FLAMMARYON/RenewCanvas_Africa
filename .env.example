# ──────────────────────────────────────────────────────────────────────────
# RenewCanvas Africa — environment template
#
# Copy to `.env` (server-only, gitignored) and fill in REAL values there.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the
# browser — keep everything else server-only.
# ──────────────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Database (Neon PostgreSQL) — server-only
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Public site URL (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend) — server-only
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM="RenewCanvas Africa <hello@yourdomain.com>"
# Inbox that receives form submissions / admin notifications (server-only).
# Falls back to the public support address if unset.
SUPPORT_INBOX_EMAIL=hello.renewcanvas@gmail.com

# AI (Anthropic - for Listing Assistant) — server-only
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# Cron Jobs (for Vercel Cron) — server-only.
# Used as `Authorization: Bearer <CRON_SECRET>` on /api/admin/reminders.
CRON_SECRET=generate-a-long-random-string

# Payments — server-only
# PAYMENT_PROVIDER: mtn_momo | manual_bank
PAYMENT_PROVIDER=mtn_momo
# REQUIRED in production. HMAC-SHA256 secret used to verify /api/payments/webhook.
# Without it the webhook is refused in production (fail closed).
PAYMENT_WEBHOOK_SECRET=generate-a-long-random-string

# MTN Mobile Money — server-only
MOMO_API_USER=your-api-user-uuid
MOMO_API_KEY=your-api-key
MOMO_SUBSCRIPTION_KEY=your-subscription-key
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_URL=http://localhost:3000/api/payments/webhook
MOMO_CURRENCY=RWF

# Vercel Blob storage (image/media uploads) — server-only
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
BLOB_STORE_ID=store_xxxxxxxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=base64-public-key

# SMS / messaging (Twilio) — server-only, optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
